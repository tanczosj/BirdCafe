                "Back to accessories.", "Custom_Accessory");

            Add("Custom_Skills",
                "Birds have <color=#00AA00>Traits</color>. Some eat less, some work faster. Traits are permanent, so choose your eggs wisely!",
                "Can I change traits?", "Custom_TraitChange",
