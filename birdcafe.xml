                 "Sparrow Info", "Lore_Sparrow",
                 "Bluejay Info", "Lore_Bluejay",
                 "Robin Info", "Lore_Robin",
                 "Owl Info", "Lore_Owl",
                 "Back to Species", "Custom_Species");

            Add("Custom_Visuals",
